# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── Queue / Redis ────────────────────────────────────────────────────────────
# Use a managed Redis URL in production (Upstash, Redis Cloud, etc.)
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2
# Max concurrent chunk render workers. Bounded by os.cpus().length at startup to prevent CPU overload.
WORKER_CONCURRENCY_CHUNKS=4
WORKER_CONCURRENCY_STITCHES=2

# ─── Authentication ───────────────────────────────────────────────────────────
# Shared secret between this worker and the main Lovable backend.
# Set the same value in the Lovable backend's RENDER_WORKER_API_KEY env var.
WORKER_API_KEY=change-me-before-deploy

# ─── Resource limits ──────────────────────────────────────────────────────────
JOB_TIMEOUT_SECONDS=600
# Floor for the per-chunk deadline (seconds). The effective budget is
# max(this, ceil(chunkDuration * 1.5) + 60), and since round 7 it drives THREE
# things, not just the BullMQ timeout:
#   - the in-process watchdog that turns a hung chunk into a retryable failure
#   - the chunk lease TTL, max(this + 60, 120) — how long a retry can wait
#     behind a lease whose holder died before releasing it
#   - the BullMQ lock duration, this + 30
#
# 600 means a genuinely hung chunk goes unnoticed for ten minutes. For a full
# 12-clip chunk the duration term is already ~150s, so anything at or below that
# has no effect on full chunks and only tightens short ones.
#
# WAS 180, chosen against a worst observed chunk of 81.6s (itself dominated by
# one 44s download at 0.47 MB/s). That basis is now stale. MEASURED over 2,895
# chunks, 2026-08-12 to 08-14:
#
#   crossed the half-budget stall notice (90s)   191   6.6%
#   killed by the watchdog                         3   0.10%
#   phase at kill                     downloading  3 of 3
#   DOWNLOAD_STALL_TIMEOUT_SECONDS fired           0
#
# All three kills landed between 180s and 300s, in one three-minute window
# during a concurrent double render, and every retry then succeeded. So 300
# removes them outright. Bytes were flowing throughout — these are slow-but-
# steady transfers under contention, not hangs, which is exactly the case the
# watchdog was NOT built for.
#
# THE COST, because this value drives three things and not one: a genuinely
# hung chunk now goes unnoticed for 300s instead of 180s, a retry can wait
# 360s instead of 240s behind a lease whose holder died, and the BullMQ lock
# runs 330s instead of 210s. That is the trade — 0.10% of chunks stop dying,
# and hang detection gets two minutes slower.
CHUNK_TIMEOUT_SECONDS=300
STITCH_TIMEOUT_SECONDS=600
# Maximum number of clips per chunk job. Smaller = more predictable per-chunk durations for long-form audio.
CHUNK_SIZE=12
MAX_CLIPS=5000
# Maximum total clip duration accepted at enqueue time (seconds). Set to 4 hours to support long-form content.
MAX_DURATION_SECONDS=14400
MAX_DOWNLOAD_BYTES=2147483648       # 2 GB across all files in a single job
MAX_STITCH_DOWNLOAD_BYTES=10737418240 # 10 GB for stitch jobs
# Hard per-clip ceiling. A single stock clip larger than this is rejected before
# its body is streamed, so an oversized source fails fast instead of timing out.
MAX_CLIP_BYTES=157286400            # 150 MB per source clip
# Total concurrent CDN downloads across the whole worker process (shared fair
# share, not per-stream). 15 by measurement: round 6 lowered this to 4 after
# saturated-pipe timeouts, but that value never reached the production box —
# its .env kept an explicit 15 throughout, so the entire healthy record (kill
# rate 0.10%, waitMs median 0, 9-10 MB/s per stream, 2026-08-12→15) was
# collected at 15 and 4 was never field-tested. The round-6 failure mode is
# now guarded directly by DOWNLOAD_MAX_SECONDS, the stall guard,
# CHUNK_TIMEOUT_SECONDS and MAX_CLIP_BYTES. See config.js for the full history.
GLOBAL_CDN_CONCURRENCY=15

# ─── Network & I/O ────────────────────────────────────────────────────────────
# Legacy total-duration cap (kept for compatibility; no longer the primary guard).
DOWNLOAD_TIMEOUT_SECONDS=60
# Abort a download only when no bytes arrive for this many seconds (stall guard).
DOWNLOAD_STALL_TIMEOUT_SECONDS=30
# Absolute per-download ceiling regardless of progress (backstop).
#
# THIS MUST STAY BELOW THE CHUNK DEADLINE OR IT CANNOT FIRE. At 600 against a
# 180s (now 300s) chunk budget it was unreachable: the watchdog always got
# there first, which is why all three kills were reported as "chunk exceeded
# 180s during downloading" rather than naming a file or a URL.
#
# Reachable is strictly better recovery, not merely better logging. A per-file
# timeout is caught by downloadAll's candidate loop, which falls through to the
# clip's fallback_urls / alternate_urls, and if every source fails the clip
# alone is degraded to a freeze frame ("CLIP UNRENDERABLE ... clip will be
# degraded, not the chunk"). The watchdog firing instead kills the whole chunk
# and re-runs all 12 downloads.
#
# 120 leaves room inside a 300s chunk for the timeout, one fallback attempt and
# the encode. It is well clear of anything observed: a normal chunk does all 12
# downloads in 5-35s, and the worst single download on record was 44s.
#
# CAVEAT, stated because it is the one number here chosen without measurement:
# per-file duration is exactly what the worker does not record today (see the
# instrumentation change). If the slow time turns out to be spread evenly
# across 12 files rather than concentrated in one, this never fires and changes
# nothing. It cannot make things worse — the fallback is a smaller rendition of
# the same footage — but it may simply do nothing.
DOWNLOAD_MAX_SECONDS=120
TEMP_DIR=/tmp/render-tmp
OUTPUT_DIR=/tmp/renders

# ─── SSRF allowlist ───────────────────────────────────────────────────────────
# Comma-separated list of hostnames the worker is allowed to fetch from.
# Add your Supabase project hostname: <project>.supabase.co
URL_ALLOWLIST=videos.pexels.com,cdn.pixabay.com,images-api.nasa.gov,images-assets.nasa.gov,player.vimeo.com,localhost

# ─── BullMQ job retry ─────────────────────────────────────────────────────────
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY_MS=5000

# ─── Watchdog circuit breaker (Round A, after the 22 August outage) ───────────
# This many watchdog kills inside the window opens the breaker for the open
# duration: chunks of admitted projects then fail immediately with a worded
# error instead of burning 300s slot-windows producing nothing, and projects
# not yet admitted hold at the admission gate until it closes. 8/900s is
# derived: the physical ceiling at 4 slots is 12 kills per 900s window, the
# baseline expectation is ~0.04, and a single bad-content chunk maxes ~3.
# Observable live:
#   redis-cli ZRANGE render:watchdog-kills 0 -1 WITHSCORES
#   redis-cli GET render:watchdog-breaker:open-until
#   redis-cli GET render:watchdog-breaker:opens        (openings in the last 24h)
WATCHDOG_BREAKER_KILLS=8
WATCHDOG_BREAKER_WINDOW_S=900
WATCHDOG_BREAKER_OPEN_S=600

# ─── Node env ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
