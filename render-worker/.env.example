# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── Queue / Redis ────────────────────────────────────────────────────────────
# Use a managed Redis URL in production (Upstash, Redis Cloud, etc.)
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2
# Max concurrent chunk render workers. Bounded by os.cpus().length at startup to prevent CPU overload.
WORKER_CONCURRENCY_CHUNKS=4
WORKER_CONCURRENCY_STITCHES=2

# ─── Authentication ───────────────────────────────────────────────────────────
# Shared secret between this worker and the main Lovable backend.
# Set the same value in the Lovable backend's RENDER_WORKER_API_KEY env var.
WORKER_API_KEY=change-me-before-deploy

# ─── Resource limits ──────────────────────────────────────────────────────────
JOB_TIMEOUT_SECONDS=600
# Floor for the per-chunk deadline (seconds). The effective budget is
# max(this, ceil(chunkDuration * 1.5) + 60), and since round 7 it drives THREE
# things, not just the BullMQ timeout:
#   - the in-process watchdog that turns a hung chunk into a retryable failure
#   - the chunk lease TTL, max(this + 60, 120) — how long a retry can wait
#     behind a lease whose holder died before releasing it
#   - the BullMQ lock duration, this + 30
#
# 600 means a genuinely hung chunk goes unnoticed for ten minutes. For a full
# 12-clip chunk the duration term is already ~150s, so anything at or below that
# has no effect on full chunks and only tightens short ones. 180 is the
# recommended value: ~2x the worst chunk observed in production (81.6s, itself
# dominated by one 44s download at 0.47 MB/s), well clear of
# DOWNLOAD_STALL_TIMEOUT_SECONDS, and it cuts the worst-case lease wait from
# 660s to 240s.
CHUNK_TIMEOUT_SECONDS=180
STITCH_TIMEOUT_SECONDS=600
# Maximum number of clips per chunk job. Smaller = more predictable per-chunk durations for long-form audio.
CHUNK_SIZE=12
MAX_CLIPS=5000
# Maximum total clip duration accepted at enqueue time (seconds). Set to 4 hours to support long-form content.
MAX_DURATION_SECONDS=14400
MAX_DOWNLOAD_BYTES=2147483648       # 2 GB across all files in a single job
MAX_STITCH_DOWNLOAD_BYTES=10737418240 # 10 GB for stitch jobs
# Hard per-clip ceiling. A single stock clip larger than this is rejected before
# its body is streamed, so an oversized source fails fast instead of timing out.
MAX_CLIP_BYTES=157286400            # 150 MB per source clip
# Total concurrent CDN downloads across the whole worker process (shared fair
# share, not per-stream). Lowered from 15 → 4: a saturated pipe split 15 ways made
# large clips time out deterministically.
GLOBAL_CDN_CONCURRENCY=4

# ─── Network & I/O ────────────────────────────────────────────────────────────
# Legacy total-duration cap (kept for compatibility; no longer the primary guard).
DOWNLOAD_TIMEOUT_SECONDS=60
# Abort a download only when no bytes arrive for this many seconds (stall guard).
DOWNLOAD_STALL_TIMEOUT_SECONDS=30
# Absolute per-download ceiling regardless of progress (backstop).
DOWNLOAD_MAX_SECONDS=600
TEMP_DIR=/tmp/render-tmp
OUTPUT_DIR=/tmp/renders

# ─── SSRF allowlist ───────────────────────────────────────────────────────────
# Comma-separated list of hostnames the worker is allowed to fetch from.
# Add your Supabase project hostname: <project>.supabase.co
URL_ALLOWLIST=videos.pexels.com,cdn.pixabay.com,images-api.nasa.gov,images-assets.nasa.gov,player.vimeo.com,localhost

# ─── BullMQ job retry ─────────────────────────────────────────────────────────
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY_MS=5000

# ─── Node env ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
